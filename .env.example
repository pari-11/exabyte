# Resend (https://resend.com) — used by app/api/enquiry to email enquiry submissions.
RESEND_API_KEY=re_your_api_key_here

# Academy inbox that receives enquiry notifications. Differs between testing and production.
ENQUIRY_RECIPIENT_EMAIL=you@example.com

# Verified "from" address. Without a verified domain in Resend, use the sandbox
# address below — sandbox mode can then only deliver to the email address on
# the Resend account itself, not to arbitrary visitor addresses.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Production no longer runs a Node server: public/enquiry.php sends the emails.
# The deploy workflow (.github/workflows/deploy.yml) builds an enquiry-config.php
# on the server from the same three values, stored as GitHub secrets.
# `npm run dev` does not run PHP, so the form only submits on the deployed site.
